# --- Core ---
DATABASE_URL=file:./.data/roas.db
# Reserved, not yet read by the app. Session ids are random UUIDs stored in the `sessions`
# table and the cookie carries only that id, so there is currently nothing to sign. Setting
# this does not add a security control today.
SESSION_SECRET=change-me-to-a-long-random-string

# Remote libSQL (Turso) also needs an auth token. Required in production — a file: URL cannot
# work on a serverless host. See docs/deploy.md.
DATABASE_AUTH_TOKEN=

# --- Connector mode ---
# sandbox  -> deterministic synthetic data generated locally (default, no credentials needed)
# live     -> call the platform's real/sandbox HTTP API using the credentials below
CONNECTOR_MODE=sandbox

# --- Amazon Ads (has a real vendor sandbox: https://advertising-api-test.amazon.com) ---
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_BASE_URL=https://advertising-api-test.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# --- Flipkart Ads / Seller (sandbox: https://sandbox-api.flipkart.net) ---
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_BASE_URL=https://sandbox-api.flipkart.net

# --- Platforms with no public self-serve ads API today.
# These ingest via scheduled report files (CSV/XLSX) dropped by the brand team,
# or via a partner API base URL once granted.
MYNTRA_BASE_URL=
NYKAA_BASE_URL=
BIGBASKET_BASE_URL=
BLINKIT_BASE_URL=
ZEPTO_BASE_URL=
