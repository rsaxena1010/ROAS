# Copy to backend/.env and fill in to move a platform out of MOCK mode.
# Every value below is optional — with nothing set, every connector runs on
# deterministic synthetic data and the whole app works out of the box.

DATABASE_URL=sqlite:///./roas.db

# --- Amazon Advertising API (Sponsored Products reporting) ---
# Create an app at https://advertising.amazon.com/API/docs, get it approved
# for API access, then generate a refresh token via the LWA authorization
# code grant. See docs/AMAZON_INTEGRATION.md.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
# sandbox | live — sandbox hits https://advertising-api-test.amazon.com
AMAZON_ADS_ENVIRONMENT=sandbox

# --- Amazon Selling Partner API (orders) ---
# Register a self-authorized SP-API app in Seller Central > Develop Apps.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_MARKETPLACE_ID=
# na | eu | fe
AMAZON_SP_REGION=na
